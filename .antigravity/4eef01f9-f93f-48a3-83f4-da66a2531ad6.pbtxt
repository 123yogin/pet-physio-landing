        }
        lines {
          text: "    fullDesc: \'Essential care post-TPLO, CCL repair, FHO, or fracture repair. We work closely with your surgeon to control post-op edema, promote surgical site incisional healing, prevent muscle atrophy, and re-establish a natural symmetrical gait.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
