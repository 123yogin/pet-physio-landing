        lines {
          text: "    id: \'faq2\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    category: \'Sessions\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    question: \'How long is a typical rehabilitation session?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    answer: \'Initial comprehensive assessments take 60 minutes. Follow-up treatment sessions typically last between 30 to 45 minutes, depending on your pet\\\'s specific needs, condition, and stamina.\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
