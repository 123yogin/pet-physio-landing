      replacement_content: "@import \"tailwindcss\";\n\n@theme {\n  --color-primary: #3C2117;\n  --color-on-primary: #ffffff;\n  --color-primary-container: #3c2117;\n  --color-on-primary-container: #ae8678;\n  --color-secondary: #84523e;\n  --color-on-secondary: #ffffff;\n  --color-secondary-container: #ffbda5;\n  --color-on-secondary-container: #7a4a37;\n  --color-tertiary: #230e00;\n  --color-on-tertiary: #ffffff;\n  --color-tertiary-container: #411f00;\n  --color-on-tertiary-container: #bc8353;\n  --color-surface: #fef9f2;\n  --color-surface-dim: #ded9d4;\n  --color-surface-bright: #fef9f2;\n  --color-surface-container-lowest: #ffffff;\n  --color-surface-container-low: #f8f3ed;\n  --color-surface-container: #f2ede7;\n  --color-surface-container-high: #ece7e2;\n  --color-surface-container-highest: #e6e2dc;\n  --color-surface-variant: #e6e2dc;\n  --color-on-surface: #1d1b18;\n  --color-on-surface-variant: #504440;\n  --color-outline: #82746f;\n  --color-outline-variant: #d4c3bd;\n  --color-background: #fef9f2;\n  --color-on-background: #1d1b18;\n  --color-error: #ba1a1a;\n  --color-on-error: #ffffff;\n  --color-error-container: #ffdad6;\n  --color-on-error-container: #93000a;\n\n  --font-display-lg: \'Plus Jakarta Sans\', sans-serif;\n  --font-headline-md: \'Plus Jakarta Sans\', sans-serif;\n  --font-headline-sm: \'Plus Jakarta Sans\', sans-serif;\n  --font-body-lg: \'Inter\', sans-serif;\n  --font-body-md: \'Inter\', sans-serif;\n  --font-label-caps: \'Inter\', sans-serif;\n}\n\n/* Material Symbols font settings */\n.material-symbols-outlined {\n  font-family: \'Material Symbols Outlined\';\n  font-weight: normal;\n  font-style: normal;\n  font-size: 24px;\n  line-height: 1;\n  letter-spacing: normal;\n  text-transform: none;\n  display: inline-block;\n  white-space: nowrap;\n  word-wrap: normal;\n  direction: ltr;\n  -webkit-font-smoothing: antialiased;\n  font-variation-settings: \'FILL\' 0, \'wght\' 300, \'GRAD\' 0, \'opsz\' 24;\n}\n\n/* Typography and Spacing Utility Helpers */\n.font-display-lg {\n  font-family: \'Plus Jakarta Sans\', sans-serif;\n  font-size: 64px;\n  line-height: 72px;\n  letter-spacing: -0.03em;\n  font-weight: 300;\n}\n\n.font-display-lg-mobile {\n  font-family: \'Plus Jakarta Sans\', sans-serif;\n  font-size: 40px;\n  line-height: 48px;\n  letter-spacing: -0.02em;\n  font-weight: 300;\n}\n\n.font-headline-md {\n  font-family: \'Plus Jakarta Sans\', sans-serif;\n  font-size: 48px;\n  line-height: 56px;\n  letter-spacing: -0.02em;\n  font-weight: 300;\n}\n\n.font-headline-sm {\n  font-family: \'Plus Jakarta Sans\', sans-serif;\n  font-size: 24px;\n  line-height: 32px;\n  font-weight: 500;\n}\n\n.font-body-lg {\n  font-family: \'Inter\', sans-serif;\n  font-size: 18px;\n  line-height: 32px;\n  font-weight: 300;\n}\n\n.font-body-md {\n  font-family: \'Inter\', sans-serif;\n  font-size: 16px;\n  line-height: 28px;\n  font-weight: 300;\n}\n\n.font-label-caps {\n  font-family: \'Inter\', sans-serif;\n  font-size: 12px;\n  line-height: 16px;\n  letter-spacing: 0.1em;\n  font-weight: 500;\n  text-transform: uppercase;\n}\n\n.max-w-container-max {\n  max-width: 1280px;\n}\n\n.px-gutter {\n  padding-left: 32px;\n  padding-right: 32px;\n}\n\n@media (max-width: 640px) {\n  .px-gutter {\n    padding-left: 20px;\n    padding-right: 20px;\n  }\n}\n\n.py-section-padding {\n  padding-top: 120px;\n  padding-bottom: 120px;\n}\n\n@media (max-width: 768px) {\n  .py-section-padding {\n    padding-top: 80px;\n    padding-bottom: 80px;\n  }\n}\n"
    }
