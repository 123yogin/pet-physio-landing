        }
        lines {
          text: "    shortDesc: \'Retraining pathways to restore balance, coordination, and mobility.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    fullDesc: \'Targeted neurological rehab for spinal stroke (FCE), degenerative myelopathy (DM), cerebellar ataxia, and nerve trauma. We stimulate neuroplasticity using proprioceptive tracks, wobble boards, and aquatic buoyancy.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
