        }
        lines {
          text: "    id: \'faq3\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    category: \'General\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    question: \'Can I stay with my pet during treatment?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    answer: \'\350\276\246Absolutely! We strongly encourage owners to be present during sessions. It keeps your pet calm and comfortable, and allows us to teach you gentle home care and massage techniques.\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    id: \'faq4\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    category: \'Insurance\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    question: \'Does pet insurance cover physiotherapy?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    answer: \'Many comprehensive pet insurance policies (such as Trupanion, Nationwide, Healthy Paws, and Petplan) cover veterinary rehabilitation and hydrotherapy when prescribed by a veterinarian. We provide itemized receipts for easy reimbursement.\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    id: \'faq5\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    category: \'Sessions\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    question: \'How many sessions will my pet need?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    answer: \'Every case is unique. Post-surgical patients usually benefit from a 6 to 8-week block (1-2 times weekly), while chronic conditions like arthritis often shift into bi-weekly or monthly maintenance once stabilized.\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    id: \'faq6\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    category: \'General\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    question: \'What if my dog is nervous around water?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    answer: \'Our underwater treadmill is filled slowly from the bottom after your pet is already calmly positioned inside with a dedicated hydrotherapist by their side. Water temperature is kept at a soothing 29-31\302\260C (84-88\302\260F), and treats/praise are used throughout.\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
